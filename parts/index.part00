<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mega_Filtro_Ultra_V5_3</title>
<style>
:root{
  --bg:#06100c;--panel:#0d1d15;--panel2:#091710;--line:#244c37;
  --text:#f1faf4;--muted:#9fbaa9;--green:#55e68e;--green2:#20b96a;
  --gold:#ffd66b;--red:#ff8080;--blue:#8ac8ff;--cyan:#72e6d0;
}
*{box-sizing:border-box}
body{
  margin:0;min-height:100vh;color:var(--text);font-family:Segoe UI,Arial,sans-serif;
  background:
    radial-gradient(circle at 15% 0%,#123e27 0,transparent 30%),
    radial-gradient(circle at 100% 10%,#122e23 0,transparent 28%),var(--bg)
}
.wrap{max-width:500px;margin:auto;padding:4px}
header{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;flex-wrap:wrap;margin-bottom:18px}
h1{margin:0;font-size:clamp(28px,5vw,48px);letter-spacing:-1px}
h1 span{color:var(--green)}
.subtitle{margin:8px 0 0;max-width:790px;color:var(--muted);line-height:1.5}
.badge{padding:9px 13px;border-radius:999px;border:1px solid var(--line);color:var(--muted);font-size:13px;background:#08150f}
.badge.ok{color:var(--green);border-color:#2f8857}.badge.err{color:var(--red);border-color:#874848}
.grid{display:grid;grid-template-columns:1fr;gap:0;max-width:100%}
@media(max-width:900px){.grid{grid-template-columns:1fr}}
.card{
  background:linear-gradient(180deg,rgba(15,36,25,.97),rgba(8,22,15,.97));
  border:1px solid var(--line);border-radius:18px;padding:20px;
  box-shadow:0 18px 44px rgba(0,0,0,.2)
}
.card h2{margin:0 0 14px;font-size:20px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:560px){.row{grid-template-columns:1fr}}
label{display:block;color:var(--muted);font-size:13px;margin:12px 0 6px}
input,select{
  width:100%;background:#07140e;color:var(--text);border:1px solid #315b43;border-radius:10px;
  padding:12px 13px;font-size:16px;outline:none
}
input:focus,select:focus{border-color:var(--green)}
button{
  border:0;border-radius:11px;padding:12px 16px;font-size:15px;font-weight:750;cursor:pointer;
  color:#04200e;background:var(--green);transition:.15s
}
button:hover{transform:translateY(-1px);filter:brightness(1.05)}
button.secondary{background:#142c20;color:var(--text);border:1px solid #315b43}
button.danger{background:#3a1919;color:#ffdada;border:1px solid #6c3636}
button:disabled{opacity:.45;cursor:not-allowed;transform:none}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.check{display:flex;align-items:center;gap:9px;margin-top:12px;color:var(--muted);font-size:14px}
.check input{width:auto;accent-color:var(--green)}
.status{
  margin-top:13px;padding:12px 14px;background:#07140e;border:1px solid #203f2e;border-radius:12px;
  color:var(--muted);font-size:13px;line-height:1.5
}
.progress{height:10px;background:#06100b;border-radius:99px;overflow:hidden;margin-top:10px;display:none}
.bar{height:100%;width:0;background:linear-gradient(90deg,var(--green2),var(--green));transition:width .12s}
.progressline{display:flex;justify-content:space-between;gap:12px;margin-top:8px;color:var(--muted);font-size:12px}
.results{margin-top:18px}
.game{
  display:grid;grid-template-columns:48px 1fr;gap:10px;align-items:center;
  border-bottom:1px solid #1d3b2a;padding:13px 6px
}
@media(max-width:580px){.game{grid-template-columns:40px 1fr}.score{grid-column:2;text-align:left!important}}
.rank{font-weight:800;color:var(--muted);text-align:left}.nums{display:flex;gap:7px;flex-wrap:wrap;justify-content:center}
.nums{display:flex;gap:7px;flex-wrap:wrap;justify-content:center}
.ball{
  min-width:39px;height:39px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;
  background:#eafff0;color:#072412;font-weight:850;border:2px solid #6ce795
}
.score{text-align:right;color:var(--gold);font-weight:850}
.small{font-size:12px;color:var(--muted)}
.kpis{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.kpi{padding:12px;background:#07140e;border:1px solid #203f2e;border-radius:12px}
.kpi span{display:block;color:var(--muted);font-size:12px}.kpi b{display:block;font-size:18px;margin-top:4px}
.note{
  margin-top:16px;padding:12px 14px;border-radius:12px;border:1px solid #6c5d2f;
  background:#211d0e;color:#f2deb0;font-size:13px;line-height:1.5
}
.goodnote{
  margin-top:12px;padding:12px 14px;border-radius:12px;border:1px solid #236b47;
  background:#0a2116;color:#bff7d5;font-size:13px;line-height:1.5
}
details{margin-top:15px;border-top:1px solid #244532;padding-top:13px}
summary{cursor:pointer;font-weight:750}
ul{color:var(--muted);line-height:1.6;padding-left:20px}
.evalout{display:none;margin-top:13px;padding:13px;border-radius:12px;background:#07140e;border:1px solid #203f2e}
.pass{color:var(--green)}.fail{color:var(--red)}
.footer{text-align:center;margin-top:18px;color:#718a7b;font-size:12px;line-height:1.5}
.pill{display:inline-block;padding:3px 7px;border-radius:999px;border:1px solid #315b43;color:var(--cyan);font-size:11px}
.stepper{display:flex;align-items:stretch;width:90px;height:46px;background:#07140e;border:1px solid #315b43;border-radius:14px;overflow:hidden}
.stepper input{
  width:54px;border:0!important;background:#07140e!important;color:var(--text);
  text-align:center;padding:0 4px;font-size:18px;font-weight:700;border-radius:0!important;
  appearance:textfield;-moz-appearance:textfield
}
.stepper input::-webkit-outer-spin-button,
.stepper input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.stepBtns{width:34px;display:flex;flex-direction:column;border-left:1px solid #244c37;background:#07140e}
.stepBtn{
  flex:1;border:0;background:#07140e;color:#aeeec5;font-size:12px;font-weight:900;
  line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0
}
.stepBtn + .stepBtn{border-top:1px solid #244c37}
.stepBtn:hover{background:#0d2017;color:#cffff0}
.stepBtn:active{background:#123022}

header,.sidepanel,.note,.footer{display:none!important}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div>
    <h1>MEGA <span>FILTRO ULTRA</span> V5.3</h1>
  </div>
  <div id="badge" class="badge">Preparando base...</div>
</header>

<div class="grid">
<section class="card">
  <div class="compactControls" style="display:flex;align-items:flex-end;justify-content:center;gap:12px;flex-wrap:nowrap;margin:8px 0 10px">
    <div class="miniField" style="width:90px;flex:0 0 90px">
      <label style="margin:0 0 6px;display:block;text-align:center">Qte. jogos:</label>
      <div class="stepper">
        <input id="qtd" type="text" inputmode="numeric" value="1" maxlength="2" aria-label="Quantidade de jogos">
        <div class="stepBtns">
          <button type="button" class="stepBtn" id="qtdUp" aria-label="Aumentar">▲</button>
          <button type="button" class="stepBtn" id="qtdDown" aria-label="Diminuir">▼</button>
        </div>
      </div>
    </div>
    <button id="generate" disabled style="flex:0 0 230px">ANALISAR E GERAR</button>
    <button id="stop" class="danger" disabled style="flex:0 0 auto">PARAR</button>
  </div>

  <div id="progress" class="progress"><div id="bar" class="bar"></div></div>
  <div class="progressline"><span id="progressText"></span><span id="eta"></span></div>
  <div id="status" class="status" style="display:none">Aguardando a base histórica ficar pronta.</div>

  <div id="results" class="results"></div>
</section>

<section class="card sidepanel">
  <h2>Base e índice universal</h2>
  <div class="kpis">
    <div class="kpi"><span>Último concurso</span><b id="kLastContest">—</b></div>
    <div class="kpi"><span>Última Mega</span><b id="kLast">—</b></div>
  </div>
  <div style="display:none">
    <span id="kMega"></span>
    <span id="kSources"></span>
  </div>

  <div id="baseStatus" class="status">
    V3 usa histórico consolidado + concursos 2.995–3.050 embutidos, evitando depender do espelho atrasado.
  </div>

  <div style="height:1px;background:#1f3d2c;margin:18px 0"></div>

  <h2>Avaliar um jogo</h2>
  <label>Digite seis dezenas</label>
  <input id="evalInput" value="" placeholder="__  __  __  __  __  __" inputmode="numeric" autocomplete="off" maxlength="17">
  <div class="actions"><button id="evalBtn" class="secondary" disabled>AVALIAR</button></div>
  <div id="evalOut" class="evalout"></div>
</section>
</div>


</div>

<script>
