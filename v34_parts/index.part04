        lastUpdate=now;await new Promise(r=>setTimeout(r,0));
        }
      }
    }
  }

  const results=pickFinal(reservoirs,q);
  postMessage({
    type:"done",stopped,results,stats,total:target,elapsed:Date.now()-start,exhaustive:all&&!stopped
  });
}
function evaluate(g){
  g=[...g].sort((a,b)=>a-b);
  const [a,b,c,d,e,f]=g;
  const rank=rank6(a,b,c,d,e,f);
  const rejection=[];
  if(hasBit(closedBits,rank))rejection.push("conjunto fechado de 6 já ocorreu no banco universal");
  if(hasBit(transformBits,rank))rejection.push("transformação histórica (+/−1, +/−2 ou espelho)");
  if(hardPattern(a,b,c,d,e,f))rejection.push("padrão matemático/estrutural de exclusão");
  if(sharesMega5(a,b,c,d,e,f))rejection.push("coincide 5/6 ou 6/6 com Mega-Sena histórica");
  let score=baseScore(a,b,c,d,e,f);
  if(sharesMega4(a,b,c,d,e,f))score=Math.max(0,score-10);
  return{game:g,approved:rejection.length===0,score:rejection.length?0:score,rejection,notes:notesFor(g)};
}

onmessage=async ev=>{
  const m=ev.data;
  if(m.type==="stop"){stopped=true;return}

  if(m.type==="init"){
    buildC();
    lastMega=m.lastMega||null;
    drawsStore=m.draws||[];

    closedBits=new Uint8Array(Math.ceil(TOTAL/8));
    transformBits=new Uint8Array(Math.ceil(TOTAL/8));
    mega5Bits=new Uint8Array(Math.ceil(C[60][5]/8));
    mega4Bits=new Uint8Array(Math.ceil(C[60][4]/8));

    let subsets=0;
    for(let i=0;i<drawsStore.length;i++){
      const d=drawsStore[i];
      subsets+=addClosed(d.nums);

      if(d.canonical&&d.nums.length===6)addTransform(d.nums);
      if(d.source==="megasena"&&d.nums.length===6)addMegaOverlapIndexes(d.nums);

      if((i&255)===0){
        postMessage({type:"initProgress",done:i+1,total:drawsStore.length,subsets});
        await new Promise(r=>setTimeout(r,0));
      }
    }

    postMessage({
      type:"ready",
      draws:drawsStore.length,
      subsets
    });
    return;
  }

  if(m.type==="scan"){await runScan(m);return}
  if(m.type==="eval"){postMessage({type:"evalResult",result:evaluate(m.game)});return}
};
`;

  const blob=new Blob([workerCode],{type:"application/javascript"});
  worker=new Worker(URL.createObjectURL(blob));

  worker.onmessage=e=>{
    const m=e.data;
    if(m.type==="initProgress"){
      const pct=Math.round(m.done/m.total*100);
      $("baseStatus").textContent=`Construindo índice universal: ${m.done.toLocaleString("pt-BR")} / ${m.total.toLocaleString("pt-BR")} registros • ${m.subsets.toLocaleString("pt-BR")} subconjuntos processados...`;
      $("badge").textContent=`Indexando ${pct}%`;
    }
    if(m.type==="ready"){
      workerReady=true;
      $("badge").className="badge ok";
      $("badge").textContent="Base + índice universal prontos";
      $("baseStatus").innerHTML=`Pronto. <b>${m.draws.toLocaleString("pt-BR")}</b> registros históricos e <b>${m.subsets.toLocaleString("pt-BR")}</b> subconjuntos de seis processados no índice.`;
      $("generate").disabled=false;$("evalBtn").disabled=false;
    }
    if(m.type==="progress"){
      const pct=Math.min(100,m.done/m.total*100);
      $("bar").style.width=pct.toFixed(2)+"%";
      $("progressText").textContent=`${m.done.toLocaleString("pt-BR")} / ${m.total.toLocaleString("pt-BR")} (${pct.toFixed(1)}%) • melhor nota: ${m.best}`;
      const speed=m.elapsed>0?m.done/(m.elapsed/1000):0;
      const remaining=speed>0?(m.total-m.done)/speed:0;
      $("eta").textContent=speed?`${Math.round(speed).toLocaleString("pt-BR")} jogos/s • ~${formatDuration(remaining*1000)} restantes`:"";
    }
    if(m.type==="done"){
      running=false;
      $("generate").disabled=false;$("stop").disabled=true;
      $("bar").style.width="100%";
      currentResults=m.results||[];
      renderResults(currentResults);
      const prefix=m.exhaustive
        ?`Varredura exaustiva concluída: <b>50.063.860 / 50.063.860</b> combinações percorridas.`
        :(m.stopped?`Análise interrompida após <b>${m.stats.scanned.toLocaleString("pt-BR")}</b> combinações.`:`Amostra concluída: <b>${m.stats.scanned.toLocaleString("pt-BR")}</b> jogos avaliados.`);
      $("status").innerHTML=
        `${prefix} Melhor nota encontrada: <b>${m.stats.best}/100</b>. `+
        `Aprovadas pelos filtros: <b>${m.stats.approved.toLocaleString("pt-BR")}</b>. `+
        `Tempo: <b>${formatDuration(m.elapsed)}</b>.`;
      $("progressText").textContent="";
      $("eta").textContent="";
      
    }
    if(m.type==="evalResult")renderEval(m.result);
  };

  worker.onerror=e=>{
    console.error(e);
    $("badge").className="badge err";$("badge").textContent="Erro no processamento";
    $("status").textContent="O navegador encontrou um erro no processador local. Recarregue a página.";
  };
}

function formatDuration(ms){
  let s=Math.max(0,Math.round(ms/1000));
  const h=Math.floor(s/3600);s%=3600;
  const m=Math.floor(s/60);s%=60;
  if(h)return`${h}h ${m}min`;
  if(m)return`${m}min ${s}s`;
  return`${s}s`;
}

function startScan(){
  if(!workerReady||running)return;
  running=true;currentResults=[];
  $("results").innerHTML="";
  $("generate").disabled=true;$("stop").disabled=false;
  $("progress").style.display="block";$("bar").style.width="0%";
  const mode="all";
  $("status").textContent="Iniciando varredura de todas as 50.063.860 combinações...";
  worker.postMessage({
    type:"scan",
    mode:"all",
    q:Number($("qtd").value)||10,
  });
}
function stopScan(){
  if(running&&worker){worker.postMessage({type:"stop"});$("status").textContent="Solicitação de parada enviada..."}
}
function renderResults(items){
  const box=$("results");box.innerHTML="";
  if(!items.length){box.innerHTML='<div class="status">Nenhum jogo final disponível.</div>';return}
  items.forEach((x,i)=>{
    const div=document.createElement("div");div.className="game";
    const notes=x.notes&&x.notes.length?`<div class="small">${x.notes.join(" · ")}</div>`:"";
    div.innerHTML=`
      <div class="rank">${String(i+1).padStart(2,"0")}.</div>
      <div>
        <div class="nums">${x.game.map(n=>`<span class="ball">${String(n).padStart(2,"0")}</span>`).join("")}</div>
        ${notes}
      </div>
      <div class="score"></div>`;
    box.appendChild(div);
  });
}
function parseEvalNumbers(value){
  const raw=String(value||"").trim();

  // Se houver separadores, aceita normalmente.
  if(/[\s,;\/-]/.test(raw)){
    return raw.split(/[\s,;\/-]+/).filter(Boolean).map(Number);
  }

  // Sem separadores: interpreta sempre em pares de 2 dígitos.
  const digits=raw.replace(/\D/g,"");
  const nums=[];
  for(let i=0;i<digits.length;i+=2){
    const pair=digits.slice(i,i+2);
    if(pair.length===2) nums.push(Number(pair));
  }
  return nums;
}

function evaluateInput(){
  if(!workerReady)return;
  const nums=parseEvalNumbers($("evalInput").value);

  if(!valid6(nums)){
    $("evalOut").style.display="block";
    $("evalOut").innerHTML='<b class="fail">Informe 6 dezenas.</b> Você pode digitar tudo junto, usando 2 dígitos por dezena.';
    return;
  }

  $("evalInput").value=nums.map(n=>String(n).padStart(2,"0")).join(" ");
  worker.postMessage({type:"eval",game:nums});
}
function renderEval(x){
  const out=$("evalOut");out.style.display="block";
  if(x.approved){
    out.innerHTML=`<b class="pass">APROVADO — Nota ${x.score}/100</b>${x.notes.length?`<br><span class="small">${x.notes.join(" · ")}</span>`:""}`;
  }else{
    out.innerHTML=`<b class="fail">REJEITADO</b><br><span class="small">• ${x.rejection.join("<br>• ")}</span>`;
  }
}


$("evalInput").addEventListener("input",e=>{
  const el=e.target;
  const digits=el.value.replace(/\D/g,"").slice(0,12);
  const pairs=digits.match(/.{1,2}/g)||[];
  el.value=pairs.join(" ");
});

$("generate").addEventListener("click",startScan);
$("stop").addEventListener("click",stopScan);
$("evalBtn").addEventListener("click",evaluateInput);

window.addEventListener("load",()=>setTimeout(loadBase,200));
</script>
</body>
</html>
